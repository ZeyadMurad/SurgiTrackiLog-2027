rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny anything not explicitly permitted
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 160 && id.matches('^[a-zA-Z0-9_\\.\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Matches the signed-in Firebase Auth email against doc.email (compatible with email/password + Google Auth;
    // no email_verified gate since immediate activation without email verification is enforced).
    function isEmailOwner(docData) {
      return isSignedIn()
        && request.auth.token.email is string
        && docData != null
        && ('email' in docData)
        && docData.email is string
        && docData.email.lower() == request.auth.token.email.lower();
    }

    function isSuperAdmin() {
      return isSignedIn()
        && (
          (
            request.auth.token.email is string
            && request.auth.token.email.lower() == 'zeadmorud2030@gmail.com'
          )
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email is string
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email.lower() == 'zeadmorud2030@gmail.com'
          )
        );
    }

    function isCommunityCaseOwner(caseData) {
      return isSignedIn() && caseData != null && (
        caseData.userId == request.auth.uid
        || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && ('aliasIds' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          && caseData.userId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.aliasIds
        )
        || (
          'authorEmail' in caseData
          && caseData.authorEmail is string
          && request.auth.token.email is string
          && caseData.authorEmail.lower() == request.auth.token.email.lower()
        )
      );
    }

    function isUserOrAliasOwner(userId) {
      return isOwner(userId)
        || isSuperAdmin()
        || (
          isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && ('aliasIds' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          && userId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.aliasIds
        );
    }

    function isValidUserPayload(data) {
      return (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && (!('aliasIds' in data) || (data.aliasIds is list && data.aliasIds.size() <= 20))
        && (!('fullName' in data) || (data.fullName is string && data.fullName.size() <= 150))
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('specialty' in data) || (data.specialty is string && data.specialty.size() <= 120))
        && (!('hospitals' in data) || (data.hospitals is string && data.hospitals.size() <= 250))
        && (!('biography' in data) || (data.biography is string && data.biography.size() <= 2000))
        && (!('followers' in data) || (data.followers is list && data.followers.size() <= 5000))
        && (!('following' in data) || (data.following is list && data.following.size() <= 5000))
        && (!('pendingFollowRequests' in data) || (data.pendingFollowRequests is list && data.pendingFollowRequests.size() <= 1000))
        && (!('role' in data) || (data.role in ['normal_user', 'super_admin']))
        && (!('verifiedHours' in data) || (data.verifiedHours is number && data.verifiedHours >= 0))
        && (!('verifiedProcedures' in data) || (data.verifiedProcedures is number && data.verifiedProcedures >= 0))
        && (!('savedVisualMedia' in data) || (data.savedVisualMedia is list && data.savedVisualMedia.size() <= 500))
        && (
          !('role' in data)
          || data.role != 'super_admin'
          || (
            ('email' in data)
            && data.email is string
            && data.email.lower() == 'zeadmorud2030@gmail.com'
            && isSignedIn()
            && request.auth.token.email is string
            && request.auth.token.email.lower() == 'zeadmorud2030@gmail.com'
          )
        );
    }

    function isValidClinicalCasePayload(data) {
      return (!('id' in data) || isValidId(data.id))
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && (!('primaryDiagnosis' in data) || (data.primaryDiagnosis is string && data.primaryDiagnosis.size() <= 1000))
        && (!('chiefComplaint' in data) || (data.chiefComplaint is string && data.chiefComplaint.size() <= 2500))
        && (!('historyOfPresentIllness' in data) || (data.historyOfPresentIllness is string && data.historyOfPresentIllness.size() <= 15000))
        && (!('specialty' in data) || (data.specialty is string && data.specialty.size() <= 150))
        && (!('hospital' in data) || (data.hospital is string && data.hospital.size() <= 300))
        && (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0))
        && (!('likedByUserIds' in data) || (data.likedByUserIds is list && data.likedByUserIds.size() <= 5000))
        && (!('likedByUsers' in data) || (data.likedByUsers is list && data.likedByUsers.size() <= 5000))
        && (!('commentsCount' in data) || (data.commentsCount is number && data.commentsCount >= 0))
        && (!('comments' in data) || (data.comments is list && data.comments.size() <= 1000))
        && (!('attachments' in data) || (data.attachments is list && data.attachments.size() <= 50));
    }

    function isValidNotificationPayload(data) {
      return (!('id' in data) || isValidId(data.id))
        && ('title' in data && data.title is string && data.title.size() >= 1 && data.title.size() <= 300)
        && ('message' in data && data.message is string && data.message.size() <= 5000)
        && (!('senderUserId' in data) || (data.senderUserId is string && data.senderUserId.size() <= 128))
        && (!('targetUserId' in data) || (data.targetUserId is string && data.targetUserId.size() <= 128))
        && (!('targetCaseId' in data) || (data.targetCaseId is string && data.targetCaseId.size() <= 128))
        && (!('isBroadcast' in data) || data.isBroadcast is bool)
        && (!('readByUserIds' in data) || (data.readByUserIds is list && data.readByUserIds.size() <= 5000))
        && (!('status' in data) || (data.status in ['pending', 'accepted', 'declined', 'rejected']));
    }

    function isValidCommunityCommentPayload(data) {
      return data.keys().hasAll(['id', 'caseId', 'userId', 'userName', 'commentText', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'caseId', 'userId', 'userName', 'userSpecialty', 'userPhotoUrl', 'commentText', 'createdAt', 'createdAtServer'
        ])
        && isValidId(data.id)
        && isValidId(data.caseId)
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 150
        && (!('userSpecialty' in data) || (data.userSpecialty is string && data.userSpecialty.size() <= 150))
        && (!('userPhotoUrl' in data) || (data.userPhotoUrl is string && data.userPhotoUrl.size() <= 350000))
        && data.commentText is string && data.commentText.size() >= 1 && data.commentText.size() <= 5000
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('createdAtServer' in data) || data.createdAtServer == request.time);
    }

    function isValidCommunityLikePayload(data) {
      return data.keys().hasAll(['userId', 'caseId', 'fullName', 'createdAt'])
        && data.keys().hasOnly([
          'userId', 'caseId', 'fullName', 'specialty', 'photoUrl', 'createdAt', 'createdAtServer'
        ])
        && isValidId(data.userId)
        && isValidId(data.caseId)
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 150
        && (!('specialty' in data) || (data.specialty is string && data.specialty.size() <= 150))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 350000))
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('createdAtServer' in data) || data.createdAtServer == request.time);
    }

    function isValidCommunityThreadPayload(data) {
      return data.keys().hasAll([
          'id', 'authorId', 'authorName', 'title', 'body', 'category', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'authorId', 'authorName', 'authorDegree', 'authorSpecialty', 'authorPhotoUrl', 'authorPosition',
          'title', 'body', 'category', 'tags', 'status', 'linkedCaseId', 'linkedCaseReference', 'linkedCaseTitle',
          'acceptedReplyId', 'pinnedAt', 'deletedByAdmin', 'viewsCount', 'repliesCount', 'likesCount',
          'viewedByUserIds', 'likedByUserIds', 'followers', 'lastReplyByUserId', 'lastReplyByName',
          'lastActivityAt', 'lastActivityAtServer', 'createdAt', 'createdAtServer', 'updatedAt', 'updatedAtServer'
        ])
        && isValidId(data.id)
        && data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 150
        && (!('authorDegree' in data) || (data.authorDegree is string && data.authorDegree.size() <= 120))
        && (!('authorSpecialty' in data) || (data.authorSpecialty is string && data.authorSpecialty.size() <= 150))
        && (!('authorPhotoUrl' in data) || (data.authorPhotoUrl is string && data.authorPhotoUrl.size() <= 350000))
        && (!('authorPosition' in data) || (data.authorPosition is string && data.authorPosition.size() <= 150))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 30000
        && data.category in ['case_discussion', 'technique', 'research', 'education', 'guidelines', 'complications', 'general', 'career']
        && data.status in ['open', 'answered', 'closed', 'pinned']
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 12))
        && (!('linkedCaseId' in data) || (data.linkedCaseId is string && data.linkedCaseId.size() <= 160))
        && (!('linkedCaseReference' in data) || (data.linkedCaseReference is string && data.linkedCaseReference.size() <= 100))
        && (!('linkedCaseTitle' in data) || (data.linkedCaseTitle is string && data.linkedCaseTitle.size() <= 500))
        && (!('acceptedReplyId' in data) || (data.acceptedReplyId is string && data.acceptedReplyId.size() <= 160))
        && (!('pinnedAt' in data) || (data.pinnedAt is string && data.pinnedAt.size() <= 64))
        && (!('deletedByAdmin' in data) || data.deletedByAdmin is bool)
        && (!('viewsCount' in data) || (data.viewsCount is number && data.viewsCount >= 0))
        && (!('repliesCount' in data) || (data.repliesCount is number && data.repliesCount >= 0))
        && (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0))
        && (!('viewedByUserIds' in data) || (data.viewedByUserIds is list && data.viewedByUserIds.size() <= 5000))
        && (!('likedByUserIds' in data) || (data.likedByUserIds is list && data.likedByUserIds.size() <= 5000))
        && (!('followers' in data) || (data.followers is list && data.followers.size() <= 5000))
        && (!('lastReplyByUserId' in data) || (data.lastReplyByUserId is string && data.lastReplyByUserId.size() <= 128))
        && (!('lastReplyByName' in data) || (data.lastReplyByName is string && data.lastReplyByName.size() <= 150))
        && (!('lastActivityAt' in data) || (data.lastActivityAt is string && data.lastActivityAt.size() <= 64))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidThreadReplyPayload(data) {
      return data.keys().hasAll([
          'id', 'threadId', 'authorId', 'authorName', 'body', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'threadId', 'authorId', 'authorName', 'authorDegree', 'authorSpecialty',
          'authorPhotoUrl', 'authorPosition', 'body', 'parentReplyId', 'likedByUserIds',
          'likesCount', 'deletedByAdmin', 'createdAt', 'createdAtServer', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.threadId)
        && data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 150
        && (!('authorDegree' in data) || (data.authorDegree is string && data.authorDegree.size() <= 120))
        && (!('authorSpecialty' in data) || (data.authorSpecialty is string && data.authorSpecialty.size() <= 150))
        && (!('authorPhotoUrl' in data) || (data.authorPhotoUrl is string && data.authorPhotoUrl.size() <= 350000))
        && (!('authorPosition' in data) || (data.authorPosition is string && data.authorPosition.size() <= 150))
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 15000
        && (!('parentReplyId' in data) || (data.parentReplyId is string && data.parentReplyId.size() <= 160))
        && (!('likedByUserIds' in data) || (data.likedByUserIds is list && data.likedByUserIds.size() <= 5000))
        && (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0))
        && (!('deletedByAdmin' in data) || data.deletedByAdmin is bool)
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidCommunityStoryPayload(data) {
      return data.keys().hasAll([
          'id', 'authorId', 'authorName', 'title', 'content', 'category', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'authorId', 'authorName', 'authorSpecialty', 'authorHospital', 'authorPhotoUrl',
          'title', 'content', 'category', 'imageUrl', 'relatedCaseId',
          'likedByUserIds', 'likesCount', 'viewedByUserIds', 'viewsCount', 'deletedByAdmin',
          'createdAt', 'createdAtServer', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 150
        && (!('authorSpecialty' in data) || (data.authorSpecialty is string && data.authorSpecialty.size() <= 150))
        && (!('authorHospital' in data) || (data.authorHospital is string && data.authorHospital.size() <= 300))
        && (!('authorPhotoUrl' in data) || (data.authorPhotoUrl is string && data.authorPhotoUrl.size() <= 350000))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 5000
        && data.category in ['clinical_pearl', 'or_moment', 'research_note', 'milestone', 'technique']
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 750000))
        && (!('relatedCaseId' in data) || (data.relatedCaseId is string && data.relatedCaseId.size() <= 160))
        && (!('likedByUserIds' in data) || (data.likedByUserIds is list && data.likedByUserIds.size() <= 5000))
        && (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0))
        && (!('viewedByUserIds' in data) || (data.viewedByUserIds is list && data.viewedByUserIds.size() <= 5000))
        && (!('viewsCount' in data) || (data.viewsCount is number && data.viewsCount >= 0))
        && (!('deletedByAdmin' in data) || data.deletedByAdmin is bool)
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidSimulationSessionPayload(data) {
      return data.keys().hasAll([
          'id', 'userId', 'sessionDate', 'sessionType', 'scenarioName', 'durationMinutes', 'verified', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'traineeId', 'sessionDate', 'sessionType', 'platformId', 'platformName',
          'scenarioName', 'procedureName', 'specialty', 'durationMinutes', 'overallScore', 'accuracyScore',
          'skillsPracticed', 'quizResults', 'verified', 'notes', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && (!('traineeId' in data) || (data.traineeId is string && data.traineeId.size() <= 128))
        && data.sessionDate is string && data.sessionDate.size() <= 64
        && data.sessionType in ['vr_simulation', 'box_trainer', 'cadaveric', 'virtual_patient', 'case_based_quiz', 'team_scenario', 'procedural_rehearsal']
        && (!('platformId' in data) || (data.platformId is string && data.platformId.size() <= 128))
        && (!('platformName' in data) || (data.platformName is string && data.platformName.size() <= 200))
        && data.scenarioName is string && data.scenarioName.size() >= 1 && data.scenarioName.size() <= 300
        && (!('procedureName' in data) || (data.procedureName is string && data.procedureName.size() <= 300))
        && (!('specialty' in data) || (data.specialty is string && data.specialty.size() <= 150))
        && data.durationMinutes is number && data.durationMinutes >= 0 && data.durationMinutes <= 1440
        && (!('overallScore' in data) || (data.overallScore is number && data.overallScore >= 0 && data.overallScore <= 100))
        && (!('accuracyScore' in data) || (data.accuracyScore is number && data.accuracyScore >= 0 && data.accuracyScore <= 100))
        && (!('skillsPracticed' in data) || (data.skillsPracticed is list && data.skillsPracticed.size() <= 50))
        && (!('quizResults' in data) || (data.quizResults is list && data.quizResults.size() <= 100))
        && data.verified is bool
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidViewedCasePayload(data) {
      return data.keys().hasAll(['caseId', 'userId', 'viewedAt'])
        && data.keys().hasOnly(['caseId', 'userId', 'viewedAt', 'viewedAtServer'])
        && isValidId(data.caseId)
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.viewedAt is string && data.viewedAt.size() <= 64
        && (!('viewedAtServer' in data) || data.viewedAtServer == request.time);
    }

    // User profiles & surgeon discovery directory (authenticated directory discovery; owner/admin writes)
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn();

      allow create: if isValidId(userId)
        && isSignedIn()
        && isValidUserPayload(incoming())
        && ('userId' in incoming()) && incoming().userId == userId
        && (isOwner(userId) || isEmailOwner(incoming()) || isSuperAdmin());

      allow update: if isValidId(userId)
        && isSignedIn()
        && isValidUserPayload(incoming())
        && (!('userId' in existing()) || incoming().userId == existing().userId)
        && (
          // Relationship / follow-request atomic sync update (follow, unfollow, accept, decline)
          incoming().diff(existing()).affectedKeys().hasOnly([
            'followers', 'followersCount', 'following', 'followingCount', 'pendingFollowRequests', 'updatedAt'
          ])
          || (
            (!('role' in existing()) || incoming().role == existing().role || isSuperAdmin())
            && (isOwner(userId) || isEmailOwner(existing()) || isSuperAdmin())
          )
        );

      allow delete: if isValidId(userId)
        && isSignedIn()
        && (isOwner(userId) || isEmailOwner(existing()) || isSuperAdmin());

      match /clinicalCases/{caseId} {
        allow get, create, update, delete: if isValidId(userId) && isValidId(caseId)
          && isUserOrAliasOwner(userId);
        allow list: if isValidId(userId)
          && (
            isUserOrAliasOwner(userId)
            || (
              isSignedIn()
              && request.auth.token.email is string
              && 'authorEmail' in resource.data
              && resource.data.authorEmail is string
              && resource.data.authorEmail.lower() == request.auth.token.email.lower()
            )
          );
      }

      match /viewedCommunityCases/{caseId} {
        allow get: if isValidId(userId) && isValidId(caseId)
          && isUserOrAliasOwner(userId);
        allow list: if isValidId(userId)
          && isUserOrAliasOwner(userId);
        allow create, update: if isValidId(userId) && isValidId(caseId)
          && isUserOrAliasOwner(userId)
          && isValidViewedCasePayload(incoming())
          && incoming().caseId == caseId
          && incoming().userId == userId;
        allow delete: if isValidId(userId) && isValidId(caseId)
          && isUserOrAliasOwner(userId);
      }

      match /supervisors/{supervisorId} {
        allow get, create, update, delete: if isValidId(userId) && isValidId(supervisorId)
          && isUserOrAliasOwner(userId);
        allow list: if isValidId(userId)
          && isUserOrAliasOwner(userId);

        match /trainingRecords/{recordId} {
          allow get, create, update, delete: if isValidId(userId) && isValidId(supervisorId) && isValidId(recordId)
            && isUserOrAliasOwner(userId);
          allow list: if isValidId(userId) && isValidId(supervisorId)
            && isUserOrAliasOwner(userId);
        }
      }

      match /trainingSessions/{sessionId} {
        allow get, create, update, delete: if isValidId(userId) && isValidId(sessionId)
          && isUserOrAliasOwner(userId);
        allow list: if isValidId(userId)
          && isUserOrAliasOwner(userId);
      }

      match /skills/{skillId} {
        allow get, create, update, delete: if isValidId(userId) && isValidId(skillId)
          && isUserOrAliasOwner(userId);
        allow list: if isValidId(userId)
          && isUserOrAliasOwner(userId);
      }

      match /recommendations/{recommendationId} {
        allow get, create, update, delete: if isValidId(userId) && isValidId(recommendationId)
          && isUserOrAliasOwner(userId);
        allow list: if isValidId(userId)
          && isUserOrAliasOwner(userId);
      }

      match /savedArticles/{articleId} {
        allow get, create, update, delete: if isValidId(userId) && isValidId(articleId)
          && isUserOrAliasOwner(userId);
        allow list: if isValidId(userId)
          && isUserOrAliasOwner(userId);
      }

      match /backups/{backupId} {
        allow get, create, update, delete: if isValidId(userId) && isValidId(backupId)
          && isUserOrAliasOwner(userId);
        allow list: if isValidId(userId)
          && isUserOrAliasOwner(userId);
      }

      match /notifications/{notificationId} {
        allow get, create, update, delete: if isValidId(userId) && isValidId(notificationId)
          && isUserOrAliasOwner(userId);
        allow list: if isValidId(userId)
          && isUserOrAliasOwner(userId);
      }

      match /simulationSessions/{sessionId} {
        allow get: if isValidId(userId) && isValidId(sessionId)
          && isUserOrAliasOwner(userId);
        allow list: if isValidId(userId)
          && isUserOrAliasOwner(userId);
        allow create: if isValidId(userId) && isValidId(sessionId)
          && isUserOrAliasOwner(userId)
          && isValidSimulationSessionPayload(incoming())
          && incoming().id == sessionId
          && incoming().userId == userId;
        allow update: if isValidId(userId) && isValidId(sessionId)
          && isUserOrAliasOwner(userId)
          && isValidSimulationSessionPayload(incoming())
          && incoming().id == existing().id
          && incoming().userId == existing().userId;
        allow delete: if isValidId(userId) && isValidId(sessionId)
          && isUserOrAliasOwner(userId);
      }
    }

    // Surgical Community Stories & Short Clinical Highlights
    match /communityStories/{storyId} {
      allow get: if isValidId(storyId) && isSignedIn();
      allow list: if isSignedIn();

      allow create: if isValidId(storyId)
        && isSignedIn()
        && isValidCommunityStoryPayload(incoming())
        && incoming().id == storyId
        && (incoming().authorId == request.auth.uid || isSuperAdmin())
        && (!('deletedByAdmin' in incoming()) || incoming().deletedByAdmin == false || isSuperAdmin());

      allow update: if isValidId(storyId)
        && isSignedIn()
        && isValidCommunityStoryPayload(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'likedByUserIds', 'likesCount', 'viewedByUserIds', 'viewsCount', 'updatedAt'
          ])
          || existing().authorId == request.auth.uid
          || isSuperAdmin()
        );

      allow delete: if isValidId(storyId)
        && isSignedIn()
        && (existing().authorId == request.auth.uid || isSuperAdmin());
    }

    // Long-Form Surgical Community Threads & Nested Replies
    match /communityThreads/{threadId} {
      allow get: if isValidId(threadId) && isSignedIn();
      allow list: if isSignedIn();

      allow create: if isValidId(threadId)
        && isSignedIn()
        && isValidCommunityThreadPayload(incoming())
        && incoming().id == threadId
        && (incoming().authorId == request.auth.uid || isSuperAdmin())
        && (!('deletedByAdmin' in incoming()) || incoming().deletedByAdmin == false || isSuperAdmin());

      allow update: if isValidId(threadId)
        && isSignedIn()
        && isValidCommunityThreadPayload(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'likedByUserIds', 'likesCount', 'followers', 'viewsCount', 'viewedByUserIds',
            'repliesCount', 'lastActivityAt', 'lastActivityAtServer', 'lastReplyByUserId', 'lastReplyByName',
            'updatedAt', 'updatedAtServer'
          ])
          || (
            existing().authorId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'body', 'category', 'tags', 'status', 'acceptedReplyId', 'updatedAt', 'updatedAtServer'
            ])
          )
          || isSuperAdmin()
        );

      allow delete: if isValidId(threadId)
        && isSignedIn()
        && (existing().authorId == request.auth.uid || isSuperAdmin());

      match /replies/{replyId} {
        allow get: if isValidId(threadId) && isValidId(replyId) && isSignedIn();
        allow list: if isValidId(threadId) && isSignedIn();

        allow create: if isValidId(threadId) && isValidId(replyId)
          && isSignedIn()
          && isValidThreadReplyPayload(incoming())
          && incoming().id == replyId
          && incoming().threadId == threadId
          && (incoming().authorId == request.auth.uid || isSuperAdmin())
          && existsAfter(/databases/$(database)/documents/communityThreads/$(threadId));

        allow update: if isValidId(threadId) && isValidId(replyId)
          && isSignedIn()
          && isValidThreadReplyPayload(incoming())
          && incoming().authorId == existing().authorId
          && incoming().threadId == existing().threadId
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['likedByUserIds', 'likesCount', 'updatedAt'])
            || (
              existing().authorId == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly(['body', 'updatedAt'])
            )
            || isSuperAdmin()
          );

        allow delete: if isValidId(threadId) && isValidId(replyId)
          && isSignedIn()
          && (existing().authorId == request.auth.uid || isSuperAdmin());
      }
    }

    // Shared Surgical Community Cases Feed (Authenticated Community Access)
    match /communityCases/{caseId} {
      allow get: if isValidId(caseId) && isSignedIn();
      allow list: if isSignedIn();

      allow create: if isValidId(caseId)
        && isSignedIn()
        && isValidClinicalCasePayload(incoming())
        && ('userId' in incoming()) && ('primaryDiagnosis' in incoming())
        && (isCommunityCaseOwner(incoming()) || isSuperAdmin());

      allow update: if isValidId(caseId)
        && isSignedIn()
        && isValidClinicalCasePayload(incoming())
        && (!('userId' in existing()) || incoming().userId == existing().userId)
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'likesCount', 'likedByUserIds', 'likedByUsers', 'commentsCount', 'comments', 'updatedAt', 'updatedAtServer'
          ])
          || isCommunityCaseOwner(existing())
          || isSuperAdmin()
        );

      allow delete: if isValidId(caseId)
        && isSignedIn()
        && (isCommunityCaseOwner(existing()) || isSuperAdmin());

      match /comments/{commentId} {
        allow get: if isValidId(caseId) && isValidId(commentId) && isSignedIn();
        allow list: if isValidId(caseId) && isSignedIn();

        allow create: if isValidId(caseId) && isValidId(commentId)
          && isValidCommunityCommentPayload(incoming())
          && incoming().caseId == caseId
          && incoming().id == commentId
          && isSignedIn()
          && (incoming().userId == request.auth.uid || isSuperAdmin())
          && existsAfter(/databases/$(database)/documents/communityCases/$(caseId));

        allow update: if false;

        allow delete: if isValidId(caseId) && isValidId(commentId)
          && isSignedIn()
          && (existing().userId == request.auth.uid || isSuperAdmin());
      }

      match /likes/{likeId} {
        allow get: if isValidId(caseId) && isValidId(likeId) && isSignedIn();
        allow list: if isValidId(caseId) && isSignedIn();

        allow create: if isValidId(caseId) && isValidId(likeId)
          && isValidCommunityLikePayload(incoming())
          && incoming().caseId == caseId
          && incoming().userId == likeId
          && isSignedIn()
          && (likeId == request.auth.uid || isSuperAdmin())
          && existsAfter(/databases/$(database)/documents/communityCases/$(caseId));

        allow update: if false;

        allow delete: if isValidId(caseId) && isValidId(likeId)
          && isSignedIn()
          && (likeId == request.auth.uid || existing().userId == request.auth.uid || isSuperAdmin());
      }
    }

    // Legacy accounts cleanup access (strictly owner or super_admin)
    match /accounts/{accountId} {
      allow get: if isValidId(accountId) && (isOwner(accountId) || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isValidId(accountId)
        && isSignedIn()
        && ('uid' in incoming() && incoming().uid is string && incoming().uid.size() <= 128)
        && ('email' in incoming() && incoming().email is string && incoming().email.size() <= 150)
        && (isOwner(accountId) || isSuperAdmin());
      allow update: if isValidId(accountId)
        && isSignedIn()
        && ('uid' in incoming() && incoming().uid is string && incoming().uid.size() <= 128)
        && ('email' in incoming() && incoming().email is string && incoming().email.size() <= 150)
        && (isOwner(accountId) || isEmailOwner(existing()) || isSuperAdmin());
      allow delete: if isValidId(accountId)
        && isSignedIn()
        && (isOwner(accountId) || isEmailOwner(existing()) || isSuperAdmin());
    }

    // Admin deletion tombstones
    match /deleted_users/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isValidId(uid) && (isOwner(uid) || isSuperAdmin());
      allow update: if isValidId(uid) && isSuperAdmin();
      allow delete: if isValidId(uid) && isSuperAdmin();
    }

    // Persistent Community & Admin Notifications (Recipient & Broadcast Scoped)
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (
        isSuperAdmin()
        || ('targetUserId' in resource.data && resource.data.targetUserId == request.auth.uid)
        || ('senderUserId' in resource.data && resource.data.senderUserId == request.auth.uid)
        || ('isBroadcast' in resource.data && resource.data.isBroadcast == true)
        || (
          (!('targetUserId' in resource.data) || resource.data.targetUserId == null || resource.data.targetUserId == '')
          && 'category' in resource.data
          && resource.data.category in ['general', 'urgent', 'clinical']
        )
      );

      allow list: if isSignedIn() && (
        isSuperAdmin()
        || ('targetUserId' in resource.data && resource.data.targetUserId == request.auth.uid)
        || ('senderUserId' in resource.data && resource.data.senderUserId == request.auth.uid)
        || ('isBroadcast' in resource.data && resource.data.isBroadcast == true)
        || (
          (!('targetUserId' in resource.data) || resource.data.targetUserId == null || resource.data.targetUserId == '')
          && 'category' in resource.data
          && resource.data.category in ['general', 'urgent', 'clinical']
        )
      );

      allow create: if isValidId(notificationId)
        && isSignedIn()
        && isValidNotificationPayload(incoming())
        && (!('senderUserId' in incoming()) || incoming().senderUserId == request.auth.uid || isSuperAdmin())
        && (!('type' in incoming()) || incoming().type != 'admin_broadcast' || isSuperAdmin())
        && (!('isBroadcast' in incoming()) || incoming().isBroadcast != true || isSuperAdmin());

      allow update: if isValidId(notificationId)
        && isSignedIn()
        && isValidNotificationPayload(incoming())
        && (!('type' in existing()) || incoming().type == existing().type)
        && (
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['readByUserIds', 'status', 'updatedAt'])
            && (
              isSuperAdmin()
              || ('targetUserId' in existing() && existing().targetUserId == request.auth.uid)
              || ('senderUserId' in existing() && existing().senderUserId == request.auth.uid)
              || ('isBroadcast' in existing() && existing().isBroadcast == true)
              || (!('targetUserId' in existing()) && 'category' in existing() && existing().category in ['general', 'urgent', 'clinical'])
            )
          )
          || (
            (!('targetUserId' in existing()) || incoming().targetUserId == existing().targetUserId)
            && (!('senderUserId' in existing()) || incoming().senderUserId == existing().senderUserId)
            && (!('targetCaseId' in existing()) || incoming().targetCaseId == existing().targetCaseId)
            && (
              isSuperAdmin()
              || ('senderUserId' in existing() && existing().senderUserId == request.auth.uid)
              || ('targetUserId' in existing() && existing().targetUserId == request.auth.uid)
            )
          )
        );

      allow delete: if isValidId(notificationId) && (
        isSuperAdmin()
        || (
          isSignedIn() && (
            ('targetUserId' in existing() && existing().targetUserId == request.auth.uid)
            || ('senderUserId' in existing() && existing().senderUserId == request.auth.uid)
          )
        )
      );
    }

    match /notification_replies/{replyId} {
      allow get: if isValidId(replyId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(replyId)
        && isSignedIn()
        && ('replyMessage' in incoming() && incoming().replyMessage is string && incoming().replyMessage.size() <= 5000);
      allow update, delete: if isSuperAdmin();
    }

    match /audit_logs/{logId} {
      allow get, list: if isSuperAdmin();
      allow create: if isValidId(logId) && isSignedIn();
      allow update, delete: if false;
    }

    match /public/surgicalNews/{articleId} {
      allow get, list: if true;
      allow write: if false;
    }

    match /system/settings {
      allow get: if true;
      allow write: if isSuperAdmin();
    }

    match /test/connection {
      allow get: if true;
      allow write: if false;
    }
  }
}
