  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Surgeon/trainee user profile and network relationships."
    },
    "/users/{userId}/clinicalCases/{caseId}": {
      "schema": "ClinicalCase",
      "description": "Subcollection of anonymous clinical cases logged by the user."
    },
    "/users/{userId}/viewedCommunityCases/{caseId}": {
      "schema": "ViewedCommunityCase",
      "description": "Persisted per-user tracking of viewed community publications."
    },
    "/users/{userId}/supervisors/{supervisorId}": {
      "schema": "Supervisor",
      "description": "Subcollection of independent supervisor profiles registered by the user."
    },
    "/users/{userId}/supervisors/{supervisorId}/trainingRecords/{recordId}": {
      "schema": "TrainingRecord",
      "description": "Supervised surgical training records strictly tied to a supervisor."
    },
    "/users/{userId}/trainingSessions/{sessionId}": {
      "schema": "TrainingSession",
      "description": "Precise documented training attendance sessions."
    },
    "/users/{userId}/skills/{skillId}": {
      "schema": "UserSkill",
      "description": "Cumulative surgical skills matrix."
    },
    "/users/{userId}/recommendations/{recommendationId}": {
      "schema": "Recommendation",
      "description": "Drafted recommendation letters for the user."
    },
    "/users/{userId}/savedArticles/{articleId}": {
      "schema": "SavedArticle",
      "description": "Saved and bookmarked surgical literature."
    },
    "/communityCases/{caseId}": {
      "schema": "ClinicalCase",
      "description": "Published clinical cases shared in the Surgical Community feed."
    },
    "/communityCases/{caseId}/comments/{commentId}": {
      "schema": "CommunityComment",
      "description": "Permanent comment records belonging to a published clinical case."
    },
    "/communityCases/{caseId}/likes/{likeId}": {
      "schema": "CommunityLike",
      "description": "Permanent per-user like records belonging to a published clinical case."
    },
    "/notifications/{notificationId}": {
      "schema": "AppNotification",
      "description": "System and social notifications with persistent read tracking."
    },
    "/notification_replies/{replyId}": {
      "schema": "NotificationReply",
      "description": "User responses to administrative broadcasts."
    },
    "/communityThreads/{threadId}": {
      "schema": "CommunityThread",
      "description": "Surgical community long-form discussion threads."
    },
    "/communityThreads/{threadId}/replies/{replyId}": {
      "schema": "ThreadReply",
      "description": "Replies belonging to a community thread."
    },
    "/users/{userId}/simulationSessions/{sessionId}": {
      "schema": "SimulationSession",
      "description": "Simulation lab session logs owned by a trainee/surgeon."
    },
    "/communityStories/{storyId}": {
      "schema": "CommunityStory",
      "description": "Shared Surgical Community stories and clinical pearls."
    }
  }
