root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,tsx,js,jsx,json,yml,yaml,css,html,md}]
indent_size = 2

[*.md]
# Markdown: preserve trailing whitespace (two trailing spaces = hard line break)
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
