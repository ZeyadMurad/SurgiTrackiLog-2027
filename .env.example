# =====================================================================
# SurgiTrack iLog – Environment template
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية:
#   cp .env.example .env
# ملف .env مستثنى من Git تلقائياً (.gitignore) ولا يُرفع إلى المستودع أبداً.
# =====================================================================

# ---------- Server-side only (بدون بادئة VITE_ = لا تصل إلى المتصفح) ----------
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GH_TOKEN: GitHub access token (server-side automation only – MUST stay secret).
GH_TOKEN="MY_GITHUB_TOKEN"

# ---------- Rate limiting & proxy (server-side) ----------
# Optional: distributed rate limiting via Upstash Redis. REQUIRED for multi-instance
# Cloud Run (otherwise each replica keeps its own counter and the effective limit
# becomes N×max). Leave empty to use the in-memory limiter (single instance).
# Create a database at https://upstash.com and copy the REST URL + token.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Number of trusted reverse-proxy tiers in front of the server (default 1, Cloud Run LB).
# Set to match your deployment's proxy chain so req.ip resolves from X-Forwarded-For.
TRUSTED_PROXY_HOPS="1"

# Set to "1" to emit Content-Security-Policy-Report-Only (non-blocking) instead of
# an enforcing CSP. Useful for a safe rollout in production. In dev, Report-Only is
# always used (Vite HMR needs inline scripts).
CSP_REPORT_ONLY=""

# SMTP (اختياري) لإرسال إيميلات التحقق من البريد.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ---------- Firebase client config (VITE_ = تُحقن في واجهة المتصفح عبر import.meta.env) ----------
# القيم من Firebase Console > Project settings. انظر src/lib/firebase.ts
VITE_FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
VITE_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="MY_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="MY_FIRESTORE_DATABASE_ID"
VITE_FIREBASE_STORAGE_BUCKET="MY_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_OAUTH_CLIENT_ID=""
VITE_FIREBASE_RECAPTCHA_SITE_KEY=""
